MISTRAL_API_KEY=your-mistral-api-key-here

# Fair-Use-Bremse des ai-proxy: KI-Aufrufe pro Konto und Minute (Default 20). Ein Dokument braucht rund vier
# Aufrufe; die Pipeline wartet bei 429 und versucht erneut, Mehrfach-Uploads werden dadurch nur langsamer.
# Lokal hochsetzen (z. B. 1000): die Tests teilen ein Konto und würden sonst mit 429 abbrechen.
AI_PROXY_BURST_LIMIT=
