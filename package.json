{
  "name": "dms-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "pnpm --filter @dms/app dev",
    "build": "pnpm --filter @dms/app build",
    "test": "bash scripts/test.sh",
    "test:only": "pnpm test:functions && pnpm test:scripts && pnpm -r test",
    "test:scripts": "node --test scripts/ocr-benchmark/",
    "ocr-benchmark": "node scripts/ocr-benchmark/run.ts && node scripts/ocr-benchmark/summary.ts",
    "test:functions": "deno test --no-lock --allow-env supabase/functions/_shared/",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:all": "bash scripts/test.sh && bash scripts/test-e2e.sh",
    "lint": "pnpm -r lint",
    "supabase": "supabase"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.95.3"
  }
}
